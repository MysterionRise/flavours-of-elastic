# Elastic Stack Configuration
# Elasticsearch + Kibana for the 8.x track (8.19 is the last 8.x minor;
# supported until 2027-07-15). Versions are kept current by Renovate; docs
# cite minors only (8.19.x), checked by scripts/check_doc_versions.py.
# renovate: datasource=docker packageName=docker.elastic.co/elasticsearch/elasticsearch depName=elasticsearch-8
ELK_VERSION=8.19.22

# Elastic Stack Credentials
# Password for the 'elastic' superuser
ELASTIC_PASSWORD=elastic

# Password for the 'kibana_system' user
KIBANA_PASSWORD=elastic

# Stable local-dev key for Kibana encrypted saved objects.
# Replace for any non-local deployment.
KIBANA_ENCRYPTION_KEY=local-dev-kibana-encryption-key-32

# Cluster name for Elastic Stack
CLUSTER_NAME=elastic-cluster

# Self-generated license: "basic" or "trial" (30 days, enables Enterprise
# features such as RRF retrievers and ML model deployment). Used by
# elk-single, elk-9 and elk.
LICENSE=basic

# License for the ML stacks (elk-ml, elk-ml-9). A trial lasts 30 days from cluster
# creation; `docker compose ... down -v` starts a fresh one.
ELK_ML_LICENSE=trial

# ============================================

# OpenSearch Configuration
# Version of OpenSearch (includes OpenSearch and OpenSearch Dashboards)
# renovate: datasource=docker packageName=opensearchproject/opensearch depName=opensearch-2
OPENSEARCH_VERSION=2.19.6

# Initial admin password for OpenSearch
# IMPORTANT: Use a strong password! Must be at least 8 characters with:
# - At least one uppercase letter
# - At least one lowercase letter
# - At least one digit
# - At least one special character
OPENSEARCH_INITIAL_ADMIN_PASSWORD=MyStrongPassword123!

# ============================================

# Elasticsearch 9 Configuration
# Elasticsearch + Kibana for the 9.x track
# renovate: datasource=docker packageName=docker.elastic.co/elasticsearch/elasticsearch depName=elasticsearch-9
ELK9_VERSION=9.5.4

# ============================================

# OpenSearch 3 Configuration
# Major version 3.x - 2-node cluster
# renovate: datasource=docker packageName=opensearchproject/opensearch depName=opensearch-3
OPENSEARCH3_VERSION=3.9.0

# ============================================

# Elasticsearch OSS (Legacy) Configuration
# FROZEN - do not update. 7.10.2 is the last Apache-2.0 release (the final
# "-oss" images). Elasticsearch has also been available under AGPLv3 since
# 8.16, but not as -oss images. Unsupported upstream: keep it on localhost.
# renovate: datasource=docker packageName=docker.elastic.co/elasticsearch/elasticsearch-oss depName=elasticsearch-oss
ELK_OSS_VERSION=7.10.2

# ============================================
# Optional overrides (defaults live in each docker-compose.yml).
# Stacks share ports 9200/5601, so run one at a time - or move one aside:
# BIND_ADDRESS=127.0.0.1     # 0.0.0.0 exposes the stack on your network
# ES_PORT=9200
# KIBANA_PORT=5601
# ES_HEAP=1g                 # elk-single, elk-9, elk, opensearch* (elk-oss: 512m)
# ES_MEM_LIMIT=2g            # container limit (elk-oss: 1g)
# KIBANA_MEM_LIMIT=2g        # Kibana / OpenSearch Dashboards (elk-oss: 1536m)
# ML_NODE_HEAP=1g            # elk-ml / elk-ml-9 nodes
# ML_NODE_MEM_LIMIT=4g       # elk-ml / elk-ml-9 nodes; ML models use 50% of this
# SETUP_TIMEOUT=300          # seconds the setup container waits (TLS stacks: 600)

# ============================================
# Usage Notes:
#
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the passwords (especially for OpenSearch)
# 3. Run docker compose with the --env-file .env flag
#
# For local development/testing, you can use simple passwords
# For production, always use strong, unique passwords
